# Neo4j connection (local or Aura). Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real credentials.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# AWS region for Amazon Bedrock (the consortium models). Default: us-east-1
AWS_REGION=us-east-1

# This demo uses Amazon Bedrock as the model provider (AWS credentials via
# `aws configure` or an AWS profile). No external API key is required.
