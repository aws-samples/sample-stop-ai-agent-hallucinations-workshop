# Environment variables for the workshop demos.
#
# Copy this file to `.env` (in the repo root, or in the specific demo folder
# such as 01-graphrag-demo/) and fill in real values. The `.env` file is
# gitignored and must never be committed.
#
# NOTE ON THE USERNAME VARIABLE: every demo in THIS repository reads
# NEO4J_USERNAME. The Workshop Studio CloudFormation environment writes a
# /workshop/.env that uses NEO4J_USER instead. If you are running inside the
# hosted workshop and a demo cannot authenticate, confirm which name is set.

# --- Neo4j (Demo 01 Graph-RAG) ---
# Self-paced with Neo4j Aura: use the neo4j+s:// URI from your AuraDB instance.
# Local Docker: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# --- AWS / Amazon Bedrock (all demos) ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Workshop Studio deployment values (auto-populated by CloudFormation) ---
# You do NOT set these when running self-paced. They are listed here to match
# the hosted workshop environment.
# NEO4J_HOST=<neo4j-nlb-endpoint>
# NEO4J_SECRET_ARN=<secrets-manager-arn>
# SECURITY_GROUP_ID=<sg-id>
# SUBNET_IDS=<subnet-a>,<subnet-b>
