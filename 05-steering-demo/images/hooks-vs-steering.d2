# Source for static/images/hooks-vs-steering.png
# Also installed as 05-steering-demo/images/hooks-vs-steering.png in the companion
# code repo (the two files are identical).
#
# Render:
#   d2 --theme 0 --pad 30 hooks-vs-steering.d2 hooks-vs-steering.png
#   then downscale to 2200px wide (sips -Z 2200).
#
# Rules for editing (see progressive-flow.d2 for the full set):
#  - Everything here comes from the demo. The hook side is MaxGuestsHook in
#    test_hooks_vs_control.py, which cancels the call on guests > 10. The steering
#    side is the steer-max-guests control in setup_controls.py: it evaluates a regex
#    over the post-LLM output text, and its steering_context tells the agent to call
#    book_hotel twice, with guests=10 and then guests=5, and to report the split.
#  - The version this replaced showed the agent retrying once with 10 guests and a
#    single booking. That is not what the control asks for and not what the demo
#    prints; it also carried the label "Agent Control" as the name of the technique,
#    which the workshop now calls steering (Agent Control is the server it uses).
#  - No timings here. The ~4s and ~6s figures in the content are one run's numbers
#    and vary with the model and the network; the content frames them as typical,
#    a diagram cannot.
#  - The regex is described in words rather than pasted: a backslash inside a d2
#    quoted label is an escape, so the pattern would not survive intact.
#  - No red/green pair: the accessibility checklist forbids it. The contrast is gray
#    (block) against AWS blue (steer). Neither side is the wrong answer here, which
#    is why the subtitle says two ways rather than better and worse.
#  - Grid layout is required: d2 0.7.1 ignores `direction` inside a container.
#  - Widths go on the inner text nodes, never on the card container. Keep both bands
#    at 3 * 505.

grid-rows: 4
vertical-gap: 26
horizontal-gap: 24

title: "Blocking and steering" {
  height: 48
  style: {
    font-size: 32
    bold: true
    stroke-width: 0
    fill: transparent
    font-color: "#16191F"
  }
}

subtitle: "The same request for 15 guests, enforcing the same 10-guest rule, handled two ways" {
  height: 28
  style: {
    font-size: 17
    stroke-width: 0
    fill: transparent
    font-color: "#5F6B7A"
  }
}

block: "Hook   ·   BeforeToolCallEvent   ·   rules live in the agent's own code" {
  grid-columns: 3
  horizontal-gap: 18
  vertical-gap: 6
  style: {
    stroke: "#5F6B7A"
    stroke-width: 2
    stroke-dash: 5
    fill: "#F7F8F9"
    border-radius: 14
    font-size: 21
    font-color: "#4A5561"
  }

  a1: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#8A96A3"
      stroke-width: 2
      fill: "#FFFFFF"
      border-radius: 10
    }
    t: "It reads the tool input" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "MaxGuestsHook sees guests=15\nbefore book_hotel is entered" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#5F6B7A"
      }
    }
  }

  a2: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#8A96A3"
      stroke-width: 2
      fill: "#FFFFFF"
      border-radius: 10
    }
    t: "The call is cancelled" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "cancel_tool returns a BLOCKED\nmessage in place of a booking" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#5F6B7A"
      }
    }
  }

  a3: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#8A96A3"
      stroke-width: 2
      fill: "#F2F3F5"
      border-radius: 10
    }
    t: "Someone has to ask again" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "The rule held, but no room was\nbooked and the flow stopped" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#4A5561"
      }
    }
  }
}

steer: "Steering   ·   STEER control on the LLM output   ·   rules live on a server" {
  grid-columns: 3
  horizontal-gap: 18
  vertical-gap: 6
  style: {
    stroke: "#0972D3"
    stroke-width: 2
    stroke-dash: 5
    fill: "#F6FAFE"
    border-radius: 14
    font-size: 21
    font-color: "#0972D3"
  }

  b1: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#0972D3"
      stroke-width: 2
      fill: "#FFFFFF"
      border-radius: 10
    }
    t: "It reads what the LLM wrote" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "A regex over the post-LLM text\nmatches any count from 11 up" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#5F6B7A"
      }
    }
  }

  b2: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#0972D3"
      stroke-width: 2
      fill: "#FFFFFF"
      border-radius: 10
    }
    t: "Guidance goes back in" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "Call book_hotel twice: guests=10,\nthen guests=5" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#5F6B7A"
      }
    }
  }

  b3: "" {
    grid-rows: 2
    vertical-gap: 6
    style: {
      stroke: "#0972D3"
      stroke-width: 2
      fill: "#EFF7FE"
      border-radius: 10
    }
    t: "Two rooms, nobody asked twice" {
      width: 505
      height: 30
      style: {
        font-size: 19
        bold: true
        stroke-width: 0
        fill: transparent
        font-color: "#16191F"
      }
    }
    s: "The user is told the reservation was\nsplit into 10 + 5 at the same hotel" {
      width: 505
      height: 56
      style: {
        font-size: 16
        stroke-width: 0
        fill: transparent
        font-color: "#0B5FA8"
      }
    }
  }
}
