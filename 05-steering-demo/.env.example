# Neo4j — READ-ONLY hotel knowledge graph (built in demo 01). Optional here:
# demo 05's bookings go to the local JSON store; Neo4j is used only to validate
# that a hotel exists before booking.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# AWS region for Amazon Bedrock (the default model provider).
AWS_REGION=us-east-1

